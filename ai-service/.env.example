# Get your API key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use for vision analysis (any OpenRouter vision model)
# Options: google/gemini-2.0-flash-001, anthropic/claude-sonnet-4, openai/gpt-4o, etc.
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Server config
HOST=0.0.0.0
PORT=8000
